# ==========================================
# LifeSamadhan Comprehensive .gitignore
# Protects all secrets, credentials, and builds
# ==========================================

# 1. Critical Secrets & Environment Files (NEVER COMMIT)
*.env
.env
.env.*
!.env.example
application-local.properties
**/application-local.properties
appsettings.Development.json
appsettings.Production.json
**/appsettings.Development.json
**/appsettings.Production.json
secrets.json
*.pem
*.key
*.p12

# 2. Node & Frontend Builds
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
**/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 3. Java & Maven Artifacts
target/
**/target/
BOOT-INF/
**/BOOT-INF/
*.class
*.jar
*.war
*.ear
.factorypath
**/.factorypath
.project
**/.project
.classpath
**/.classpath
.settings/
**/.settings/

# 4. .NET & C# Artifacts
bin/
**/bin/
obj/
**/obj/
*.suo
*.user
*.userprefs
*.sln.docstates
*.userosscache

# 5. IDEs, Editors & Metadata
.idea/
**/.idea/
.metadata/
**/.metadata/
.vscode/*
!.vscode/extensions.json
*.sw?
*.bak

# 6. Scratch & Agent Test Artifacts
scratch/
**/.system_generated/
*.log

# 7. OS Generated
.DS_Store
Thumbs.db
